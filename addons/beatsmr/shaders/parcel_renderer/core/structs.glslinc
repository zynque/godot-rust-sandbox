struct ParcelShape {
    vec3 forward;
    vec3 normal;

    // Measured in standard deviations, not spatial distances.
    float axis_length;
    float width;
    float height;
};

struct Parcel {
    vec3 mean;
    mat3 covariance;
    mat3 inverseCovariance;
    float peakDensity;
    vec3 color;
};

struct ParcelIntersection {
    bool isSurface;
    float density;
    vec3 point;
    vec3 normal;
};

// Outcome of searching a ray's interval buckets for matter: where along the
// ray the search settled and the density there.
struct SurfaceSample {
    // Distance along the ray.
    float position;
    // Total parcel density at that distance.
    float density;
    // True when a threshold crossing was found and refined to the surface;
    // false when no crossing was observed and the densest bucket was returned.
    bool isSurface;
};

// TODO: array of indices instead of Parcels
struct ParcelBundle {
    Parcel[MAX_CANDIDATES] parcels;
    int size;
};

struct Ray {
    vec3 origin;
    vec3 direction; // Normalized.
};

// TODO: deprecate in favor of parcel interals and clustering
struct BoundaryIntervalSet {
    float[2 * MAX_CANDIDATES] distances;
    int size;
};

// An interval where the camera ray intersects a parcel's boundary
struct ParcelInterval {
    // measured as distance from camera
    float entry;
    float exit;
    int parcel_index;
};

struct ParcelSet {
    uint[MAX_PARCELS] indices;
    uint size;
};

struct ParcelIntervals {
    ParcelInterval[MAX_PARCEL_INTERVALS] items;
    uint size;
};

struct ParcelIntervalCluster {
    float[MAX_PARCELS] inflection_points;
    ParcelSet parcels;
    uint size;
};

struct ParcelIntervalBucketWeights16 {
    // positions along ray ordered front to back
    // each pair of consecutive positions define a bucket
    // note length is 1 more than the number of buckets
    float[INTERVAL_BUCKET_POINTS] buckets;
    // Per bucket, estimated from the density observations inside it:
    // positions[] is where that density is estimated to sit along the ray,
    // evidence[] the average squared density observed (the mean of the sample
    // weights), samples[] how many density samples the bucket has tested and
    // deviations[] the accumulated weighted squared deviation around
    // positions[].
    float[INTERVAL_BUCKET_COUNT] positions;
    float[INTERVAL_BUCKET_COUNT] evidence;
    uint[INTERVAL_BUCKET_COUNT] samples;
    float[INTERVAL_BUCKET_COUNT] deviations;
    ParcelSet parcels;
};
