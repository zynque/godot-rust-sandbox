#define MIN_FLOAT -1e38
#define MAX_FLOAT 1e38

#define MAX_STEPS 2000
#define ISOSURFACE 0.5
#define STEP_SIZE 0.005
#define MAX_CANDIDATES 32
#define PARCEL_BOUND_SIGMAS 3.0
#define MAX_CLUSTER 10

#define MAX_PARCELS 100

// intersect_parcels() returns at most one interval per parcel in the set.
#define MAX_PARCEL_INTERVALS MAX_PARCELS

#define MAX_PARCELS_PER_BATCH 100

// ParcelIntervalBucketWeights16 stratifies a cluster into this many buckets
// using one more boundary position than there are buckets.
#define INTERVAL_BUCKET_COUNT 16
#define INTERVAL_BUCKET_POINTS 17

// update_random_interval_bucket_weight() picks a bucket with probability
// proportional to evidence * (deviation + this floor). The floor keeps a
// bucket that has evidence but no measured spread yet in the running.
#define INTERVAL_BUCKET_WEIGHT_EPSILON 1e-4

// A bucket that observed no interval midpoint during initialization is given
// this fraction of the average evidence the observed buckets carry, so weighted
// sampling can still reach it while the observed buckets keep priority.
#define INTERVAL_BUCKET_UNOBSERVED_EVIDENCE_FRACTION 0.5

// search_interval_bucket_surface() refines the first threshold crossing with a
// safeguarded Newton iteration. It stops after this many passes, when the
// density residual drops below SURFACE_RESIDUAL_EPSILON, or whenever the
// ray-aligned slope is too shallow to divide by (below SURFACE_SLOPE_EPSILON)
// or the Newton step would leave the bracket, in which case it bisects instead.
#define SURFACE_NEWTON_ITERATIONS 8
#define SURFACE_RESIDUAL_EPSILON 1e-5
#define SURFACE_SLOPE_EPSILON 1e-6

// Once the stochastic buckets have narrowed the range, the surface search walks
// it with exact density samples at this target step, centred to keep the sample
// count within the cap. The step matches the old marching resolution but only
// spans the narrowed range, which is usually tiny.
#define INTERVAL_SURFACE_SCAN_STEP 0.005
#define INTERVAL_SURFACE_SCAN_MAX_STEPS 512

// traceParcels() folds this many stochastic density observations into the
// bucket estimates before searching them for the surface, so every bucket has
// evidence to compare against the threshold.
#define INTERVAL_BUCKET_SAMPLING_PASSES 32

// Each sampling pass narrows the bucket range with
// narrow_interval_bucket_weights(): the leading and trailing buckets whose
// estimated density stays below this fraction of ISOSURFACE are dropped and the
// remaining span is restratified into fresh, finer buckets. A fraction below 1
// keeps a margin of sub-threshold buckets so the crossing stays bracketed.
#define INTERVAL_BUCKET_NARROW_THRESHOLD_FRACTION 0.3
