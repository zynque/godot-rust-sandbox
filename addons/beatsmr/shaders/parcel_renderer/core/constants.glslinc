#ifndef MIN_FLOAT
#define MIN_FLOAT -1e38
#endif
#ifndef MAX_FLOAT
#define MAX_FLOAT 1e38
#endif

#ifndef MAX_STEPS
#define MAX_STEPS 2000
#endif
#ifndef ISOSURFACE
#define ISOSURFACE 0.5
#endif
#ifndef STEP_SIZE
#define STEP_SIZE 0.005
#endif
#ifndef MAX_CANDIDATES
#define MAX_CANDIDATES 32
#endif
// Culling bound for a parcel's ray interval, in standard deviations. Lowering
// this shrinks every cluster's search span, but clips density that lies beyond
// this many sigmas.
#ifndef PARCEL_BOUND_SIGMAS
#define PARCEL_BOUND_SIGMAS 2.0
#endif
#ifndef MAX_CLUSTER
#define MAX_CLUSTER 10
#endif

#ifndef MAX_PARCELS
#define MAX_PARCELS 30
#endif

// intersect_parcels() returns at most one interval per parcel in the set.
#ifndef MAX_PARCEL_INTERVALS
#define MAX_PARCEL_INTERVALS MAX_PARCELS
#endif

#ifndef MAX_PARCELS_PER_BATCH
#define MAX_PARCELS_PER_BATCH 30
#endif

// refine_surface_distance() refines the first threshold crossing with a
// safeguarded Newton iteration. It stops after this many passes, when the
// density residual drops below SURFACE_RESIDUAL_EPSILON, or whenever the
// ray-aligned slope is too shallow to divide by (below SURFACE_SLOPE_EPSILON)
// or the Newton step would leave the bracket, in which case it bisects instead.
#ifndef SURFACE_NEWTON_ITERATIONS
#define SURFACE_NEWTON_ITERATIONS 3
#endif
#ifndef SURFACE_RESIDUAL_EPSILON
#define SURFACE_RESIDUAL_EPSILON 1e-5
#endif
#ifndef SURFACE_SLOPE_EPSILON
#define SURFACE_SLOPE_EPSILON 1e-6
#endif

// search_cluster_surface_adaptive() splits candidate intervals until they are
// this narrow, then refines the crossing inside them. Larger values stop the
// subdivision earlier (faster, coarser) and smaller values refine further.
#ifndef ADAPTIVE_INTERVAL_EPSILON
#define ADAPTIVE_INTERVAL_EPSILON 1e-2
#endif
// Candidate interval stack depth. Each entry costs one upper-bound test plus up
// to three density samples, so this bounds the worst-case cost per cluster.
#ifndef MAX_ADAPTIVE_INTERVALS
#define MAX_ADAPTIVE_INTERVALS 12
#endif
