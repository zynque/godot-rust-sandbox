vec3 getCameraPosition() {
    return (inverse(camera_params.view) * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
}

vec3 getCameraDirection(vec2 fragCoord) {
    vec2 normalized = (fragCoord / iResolution.xy) * 2.0 - 1.0;
    normalized.y = -normalized.y;

    vec4 nearClip = vec4(normalized, -1.0, 1.0);
    vec4 farClip = vec4(normalized, 1.0, 1.0);

    vec4 nearView = inverse(camera_params.projection) * nearClip;
    vec4 farView = inverse(camera_params.projection) * farClip;
    nearView /= nearView.w;
    farView /= farView.w;

    vec4 nearWorld = inverse(camera_params.view) * nearView;
    vec4 farWorld = inverse(camera_params.view) * farView;
    return normalize((farWorld.xyz - nearWorld.xyz));
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    ParcelSet set;
    set.size = SCENE_PARCEL_COUNT;
    for (uint i = 0u; i < set.size; i++) {
        set.indices[i] = i;
    }

    vec3 cameraPosition = getCameraPosition();
    if (length(cameraPosition) < 0.0001) {
        cameraPosition = vec3(0.0, 1.0, 5.0);
    }

    vec3 cameraDirection = getCameraDirection(fragCoord);
    if (length(cameraDirection) < 0.0001) {
        cameraDirection = vec3(0.0, 0.0, -1.0);
    }

    Ray ray = Ray(cameraPosition, cameraDirection);
    ParcelIntersection intersection = traceParcels(ray, set);

    vec3 color = intersection.color;
    if (length(color) < 0.0001) {
        color = vec3(intersection.density);
    }

    if (intersection.isSurface) {
        float light = getLight(intersection.point, intersection.normal);
        color *= max(light, 0.15);
    }
    else {
        color *= clamp(intersection.density, 0.0, 1.0);
    }

    fragColor = vec4(color, 1.0);
}
