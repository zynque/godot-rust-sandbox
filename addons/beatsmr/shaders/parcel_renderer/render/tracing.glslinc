vec3 dominant_parcel_color(vec3 p, ParcelSet set) {
    vec3 color = vec3(0.0);
    float best_density = -1.0;

    for (uint i = 0u; i < set.size; i++) {
        Parcel parcel = parcel_buffer[set.indices[i]];
        float density = parcelDensity(p, parcel);
        if (density > best_density) {
            best_density = density;
            color = parcel.color;
        }
    }

    return color;
}

ParcelIntersection make_empty_intersection(Ray ray) {
    ParcelIntersection empty;
    empty.isSurface = false;
    empty.density = 0.0;
    empty.point = ray.origin;
    empty.normal = -ray.direction;
    empty.color = vec3(0.0);
    return empty;
}

void copy_cluster(ParcelIntervals source, inout ParcelIntervals cluster, uint start_index, uint cluster_size) {
    cluster.size = cluster_size;
    for (uint i = 0u; i < cluster_size; i++) {
        cluster.items[i] = source.items[start_index + i];
    }
}

ParcelIntervals build_cluster(ParcelIntervals intervals, uint cluster_start) {
    ParcelIntervals cluster;
    uint cluster_size = 1u;

    while (cluster_start + cluster_size < intervals.size &&
           intervals_overlap(intervals.items[cluster_start], intervals.items[cluster_start + cluster_size])) {
        cluster_size++;
    }

    copy_cluster(intervals, cluster, cluster_start, cluster_size);
    return cluster;
}

SurfaceSample evaluate_cluster_surface(Ray ray, ParcelIntervals cluster, ParcelSet set) {
    float cluster_front = cluster.items[0].entry;
    float cluster_back = cluster.items[cluster.size - 1u].exit;
    return search_cluster_surface_adaptive(ray, set, cluster_front, cluster_back);
}

ParcelIntersection make_surface_intersection(Ray ray, SurfaceSample surface_sample, ParcelSet set) {
    ParcelIntersection intersection;
    intersection.isSurface = surface_sample.isSurface;
    intersection.density = surface_sample.density;
    intersection.point = ray.origin + surface_sample.position * ray.direction;
    intersection.normal = normalize(-total_parcel_density_gradient(intersection.point, set));
    intersection.color = dominant_parcel_color(intersection.point, set);
    return intersection;
}

// Traces a ray against the parcels in `set` for the first density threshold
// crossing that marks a solid surface. The ray's parcel intervals are grouped
// into overlapping clusters, each cluster is searched in turn, and we keep
// walking the ray until either a solid surface is found or every cluster has
// been evaluated. This allows a later parcel cluster to contribute visible
// density even when a nearer set of parcels does not produce a valid surface.
ParcelIntersection traceParcels(Ray ray, ParcelSet set) {
    ParcelIntersection empty = make_empty_intersection(ray);

    ParcelIntervals intervals = intersect_parcels(ray, set);
    if (intervals.size == 0u)
        return empty;

    sort_intervals(intervals);

    ParcelIntersection best = empty;
    uint cluster_start = 0u;
    while (cluster_start < intervals.size) {
        ParcelIntervals cluster = build_cluster(intervals, cluster_start);
        SurfaceSample surface_sample = evaluate_cluster_surface(ray, cluster, set);

        if (surface_sample.isSurface) {
            return make_surface_intersection(ray, surface_sample, set);
        }

        if (surface_sample.density > best.density) {
            best = make_surface_intersection(ray, surface_sample, set);
            best.isSurface = false;
        }

        cluster_start += cluster.size;
    }

    return best;
}

float getLight(vec3 p, vec3 normal) {
    vec3 lightPos = vec3(0, 6, 0);
    vec3 lightVector = normalize(lightPos - p);
    float diffuse = clamp(dot(normal, lightVector), 0.0, 1.0);
    return diffuse;
}
