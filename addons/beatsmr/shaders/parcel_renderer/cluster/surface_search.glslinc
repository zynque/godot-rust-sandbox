// ---------------------------------------------------------------------------
// Surface search over the interval bucket estimates
// ---------------------------------------------------------------------------

// Safeguarded Newton solve of total_parcel_density(p(t)) == ISOSURFACE on
// [lo, hi], where the density sits at or below the threshold at lo and above it
// at hi. Every pass narrows the bracket by the sign of the residual, then moves
// t either along the ray-aligned density gradient (a Newton step) or to the
// bracket midpoint. A Newton step is rejected and the bracket halved whenever
// the slope is too shallow to divide by or the step would leave the bracket, so
// the iteration cannot escape the crossing region.
float refine_surface_distance(Ray ray, ParcelSet parcels, float lo, float hi) {
    float t = 0.5 * (lo + hi);
    for (uint i = 0u; i < SURFACE_NEWTON_ITERATIONS; i++) {
        vec3 p = ray.origin + t * ray.direction;
        float residual = total_parcel_density(p, parcels) - ISOSURFACE;
        if (abs(residual) < SURFACE_RESIDUAL_EPSILON)
            break;

        if (residual > 0.0)
            hi = t;
        else
            lo = t;

        float slope = dot(total_parcel_density_gradient(p, parcels), ray.direction);
        float step = abs(slope) > SURFACE_SLOPE_EPSILON
            ? t - residual / slope
            : 0.5 * (lo + hi);
        t = (step > lo && step < hi) ? step : 0.5 * (lo + hi);
    }
    return t;
}

// Resolves the surface along the ray over the (already narrowed) bucket span
// with exact density samples. The stochastic buckets have localized where
// density is of interest; this walks that span at a fixed resolution with a
// bounded sample count, takes the first step that rises through ISOSURFACE as
// the crossing bracket, refines it with the guarded Newton solve and reports
// the exact density there. When no step crosses the threshold it reports the
// densest sample instead, so the result is a smooth, deterministic function of
// the ray rather than a jumpy per-pixel estimate.
SurfaceSample search_interval_bucket_surface(ParcelIntervalBucketWeights16 buckets, Ray ray) {
    SurfaceSample result;
    result.position = 0.0;
    result.density = 0.0;
    result.isSurface = false;

    if (buckets.parcels.size == 0u)
        return result;

    float front = buckets.buckets[0];
    float back = buckets.buckets[uint(INTERVAL_BUCKET_COUNT)];
    float span = back - front;
    float count = clamp(
        ceil(span / INTERVAL_SURFACE_SCAN_STEP),
        1.0,
        float(INTERVAL_SURFACE_SCAN_MAX_STEPS)
    );
    float step = span / count;
    int steps = int(count);

    float front_density =
        total_parcel_density(ray.origin + front * ray.direction, buckets.parcels);
    if (front_density > ISOSURFACE) {
        result.position = front;
        result.density = front_density;
        result.isSurface = true;
        return result;
    }

    float previous = front;
    float densest_position = front;
    float densest_density = front_density;

    for (int i = 1; i <= steps; i++) {
        float t = front + step * float(i);
        float density =
            total_parcel_density(ray.origin + t * ray.direction, buckets.parcels);
        if (density > densest_density) {
            densest_density = density;
            densest_position = t;
        }
        if (density > ISOSURFACE) {
            float position = refine_surface_distance(ray, buckets.parcels, previous, t);
            result.position = position;
            result.density = total_parcel_density(
                ray.origin + position * ray.direction,
                buckets.parcels
            );
            result.isSurface = true;
            return result;
        }
        previous = t;
    }

    result.position = densest_position;
    result.density = densest_density;
    return result;
}
