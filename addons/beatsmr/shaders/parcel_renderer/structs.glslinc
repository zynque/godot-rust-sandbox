struct ParcelShape {
    vec3 forward;
    vec3 normal;

    // Measured in standard deviations, not spatial distances.
    float axis_length;
    float width;
    float height;
};

struct Parcel {
    vec3 mean;
    mat3 covariance;
    mat3 inverseCovariance;
    float peakDensity;
    vec3 color;
};

struct ParcelIntersection {
    bool isSurface;
    float density;
    vec3 point;
    vec3 normal;
};

// TODO: array of indices instead of Parcels
struct ParcelBundle {
    Parcel[MAX_CANDIDATES] parcels;
    int size;
};

struct Ray {
    vec3 origin;
    vec3 direction; // Normalized.
};

// TODO: deprecate in favor of parcel interals and clustering
struct BoundaryIntervalSet {
    float[2 * MAX_CANDIDATES] distances;
    int size;
};

// An interval where the camera ray intersects a parcel's boundary
struct ParcelInterval {
    // measured as distance from camera
    float entry;
    float exit;
    int parcel_index;
};

struct ParcelSet {
    uint[MAX_PARCELS] indices;
    uint size;
};

struct ParcelIntervals {
    ParcelInterval[MAX_PARCEL_INTERVALS] items;
    uint size;
};

struct ParcelIntervalCluster {
    uint start; // index of the first interval in the cluster
    uint count;
    float enter;
    float exit;
};

struct ParcelIntervalClusterSet {
    ParcelInterval[MAX_CANDIDATES] intervals;
    ParcelIntervalCluster[MAX_CANDIDATES] clusters;
    int size;
};

struct Range {
    uint start;
    uint size;
};
