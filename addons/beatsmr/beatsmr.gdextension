[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
windows.debug.x86_64   = "res://addons/beatsmr/rust/target/debug/beatsmr.dll"
windows.release.x86_64 = "res://addons/beatsmr/rust/target/release/beatsmr.dll"
linux.debug.x86_64     = "res://addons/beatsmr/rust/target/debug/libbeatsmr.so"
linux.release.x86_64   = "res://addons/beatsmr/rust/target/release/libbeatsmr.so"
macos.debug            = "res://addons/beatsmr/rust/target/debug/libbeatsmr.dylib"
macos.release          = "res://addons/beatsmr/rust/target/release/libbeatsmr.dylib"
